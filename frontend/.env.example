# Copy to .env.local and adjust. .env.local is git-ignored.
CLOUDOPS_API_URL=http://127.0.0.1:8000

# Browser-safe Supabase project URL and publishable key only.
# Never place a secret/service-role key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
