# Copy to .env and fill in your own values. Never commit .env.

# SQLAlchemy URL for PostgreSQL (psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/cloudops

# Optional
# DATABASE_ECHO=false          # log SQL statements
# DATABASE_AUTO_CREATE=true    # create missing tables on startup

# Only used by the test suite. Point it at a throwaway database: tests wipe it.
# TEST_DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/cloudops_test
