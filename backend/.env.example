# Copy to .env and fill in your own values. Never commit .env.

# SQLAlchemy URL for PostgreSQL (psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/cloudops

# Required to enable authenticated service and integration registry APIs.
SUPABASE_URL=https://your-project.supabase.co

# Optional
# DATABASE_ECHO=false
# DATABASE_AUTO_CREATE=false
# DATABASE_CONNECT_TIMEOUT=5
# OTLP_MAX_BODY_BYTES=10485760

# Only used by the test suite. Point it at a throwaway database: tests wipe it.
# TEST_DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/cloudops_test

# Required to accept OTLP collector traffic; use a long random secret.
# Send this value in the X-OTLP-API-Key header from your collector.
OTLP_INGESTION_API_KEY=
